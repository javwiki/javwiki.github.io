# 必须是 Clash / Mihomo YAML 订阅；订阅中需要包含真实日本节点。
CLASH_SUBSCRIPTION_URL=https://your-provider.example/clash?token=replace-me
# 使用 openssl rand -hex 24 生成；请勿提交真实密钥或订阅。
CLASH_CONTROLLER_SECRET=replace-with-a-random-secret
# Python 正则表达式；按节点名称筛选，并非出口地理位置验证。
JAPAN_FILTER=(?i)(日本|Japan|Tokyo|Osaka|东京|東京|大阪|🇯🇵|\bJP\b)
